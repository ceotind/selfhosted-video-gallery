# Copy to .env and edit. Every value is optional.

# The folder that holds your videos. Absolute paths work best.
VIDEOS_DIR=/srv/videos

# The folder that holds the database. It is created if missing.
DATA_DIR=./data

# The port the site listens on.
GALLERY_PORT=8080

# Local development only. Skip the folder scan at start, run "pnpm run scan" by hand.
# DEV_SKIP_SCAN=1

# Local development only. Every person sees every folder until a rule hides one.
# Production leaves this unset and starts with every folder hidden.
# FOLDERS_OPEN=1

# Your user and group id, so the database folder belongs to you.
# Run: id -u  and  id -g
PUID=1000
PGID=1000